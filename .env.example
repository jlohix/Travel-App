# Database (SQLite by default)
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Change this to any long random string.
AUTH_SECRET="change-me-to-a-long-random-string"

# Google Gemini API key (free tier) for the itinerary generator.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
